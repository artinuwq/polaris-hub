APP_NAME=polaris
DEBUG=true
DATABASE_URL=sqlite:///database/data/polaris.db

TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_WEBHOOK_URL=
# На VPS с кривым IPv6 оставьте true (иначе ответы бота могут идти 20–60с)
TELEGRAM_FORCE_IPV4=true
# Сколько секунд действителен initData Mini App (по умолчанию 24ч)
TELEGRAM_INIT_DATA_MAX_AGE=86400

# Обновление из git (кнопка / команда /update)
UPDATE_BRANCH=main
UPDATE_REMOTE=origin
# UPDATE_REPO_DIR=   # по умолчанию ищется ближайший .git
# UPDATE_SERVICE_NAME=polaris   # systemctl restart после update (Linux)
UPDATE_API_TOKEN=change-me

WEB_HOST=127.0.0.1
WEB_PORT=8000
