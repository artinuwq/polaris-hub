APP_NAME=polaris
DEBUG=true
DATABASE_URL=sqlite:///database/data/polaris.db

TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_WEBHOOK_URL=
# HTTPS URL Mini App (обязательно для кнопки web_app в боте)
# Пример: https://your-domain.com/  или туннель cloudflared/ngrok
WEBAPP_URL=
# Короткое имя Mini App в BotFather: ссылка из уведомлений вида t.me/<бот>/<имя>?startapp=...
MINIAPP_NAME=app
# Часовой пояс для напоминаний об оплате (15:00 за 3 дня и за день, 10:00 в день платежа)
NOTIFY_TIMEZONE=Europe/Helsinki
# На VPS с кривым IPv6 оставьте true (иначе ответы бота могут идти 20–60с)
TELEGRAM_FORCE_IPV4=true
# Сколько секунд действителен initData Mini App (по умолчанию 24ч)
TELEGRAM_INIT_DATA_MAX_AGE=86400

# Обновление из git (кнопка / команда /update)
UPDATE_BRANCH=main
UPDATE_REMOTE=origin
# UPDATE_REPO_DIR=   # по умолчанию ищется ближайший .git
# UPDATE_SERVICE_NAME=polaris   # systemctl restart после update (Linux)
UPDATE_API_TOKEN=change-me

WEB_HOST=127.0.0.1
WEB_PORT=8000

# Почта (необязательно)
# MAIL_POLL_INTERVAL=30                                  # как часто опрашивать ящики, секунд (минимум 15)
# TELEGRAM_PROXY_URL=socks5h://user:pass@host:1080       # прокси только для отправки писем в Telegram
# Вид текста письма в Telegram: details — раскрывающийся блок (по умолчанию),
# quote — обычное сообщение с раскрывающейся цитатой, plain — просто текст
MAIL_BODY_STYLE=details

# Storage — внутреннее хранилище файлов (SQLite + Telegram как backend), см. docs/storage.md
# STORAGE_ENABLED=false
# CLOUD_STORAGE_CHAT_ID=-1001234567890   # чат/канал, где бот — админ (право удалять сообщения желательно)
# STORAGE_DB_PATH=                       # по умолчанию database/data/storage.db (переживает /update)
# STORAGE_CHUNK_SIZE_MIB=15              # максимум 19: getFile отдаёт не больше 20 MB
# STORAGE_CONNECT_TIMEOUT=10
# STORAGE_READ_TIMEOUT=120
# STORAGE_MAX_RETRIES=3
# STORAGE_RETRY_DELAY=2
# STORAGE_MAX_CONCURRENT_UPLOADS=2
# STORAGE_MAX_CONCURRENT_DOWNLOADS=4
# STORAGE_STALE_UPLOAD_SECONDS=1800      # через сколько без прогресса чужая загрузка считается заброшенной
# STORAGE_MAINTENANCE_INTERVAL=600       # период фоновой сверки, сек (0 — только при старте)
# Прокси и IPv4 берутся из TELEGRAM_PROXY_URL / TELEGRAM_FORCE_IPV4 / TELEGRAM_API_BASE

# S3-совместимый API внутри Polaris (требует STORAGE_ENABLED=true), см. docs/s3-api.md
# S3_ENABLED=false
# S3_PATH_PREFIX=/s3                    # endpoint = http(s)://<хост Polaris>/s3 (корень занят Mini App)
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_CREDENTIALS=id2:secret2,id3:secret3 # дополнительные ключи; S3_DISABLED_KEYS=id3 — отключить без удаления
# S3_MAX_REQUEST_SIZE_MIB=5120          # максимум одного PutObject/UploadPart
# S3_CLOCK_SKEW_SECONDS=900             # допустимое расхождение часов клиента (SigV4)
# S3_MIN_PART_SIZE_MIB=5                # минимальный размер части multipart (кроме последней)
# S3_MULTIPART_EXPIRY_HOURS=0           # 0 — незавершённые multipart-загрузки не истекают
# S3_BODY_TIMEOUT=60                    # сек. простоя при чтении тела запроса

# Управление Storage из интерфейса (раздел Storage → Configuration пишет эти параметры в .env)
# STORAGE_TELEGRAM_BOT_TOKEN=            # отдельный бот хранилища; пусто — используется TELEGRAM_BOT_TOKEN
# STORAGE_MASTER_KEY=                    # 32+ байт (hex/base64) для вывода секретов S3-ключей; пусто — файл ниже
# STORAGE_MASTER_KEY_PATH=               # по умолчанию database/data/storage_master.key (создаётся с правами 0600).
#                                          Сделайте резервную копию: без него ключи из интерфейса придётся перевыпускать
